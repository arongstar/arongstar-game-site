---
import Base from '../../../layouts/Base.astro';
import { allUnits } from '../../../lib/content';
import { reportData } from '../../../lib/reportdata';
import { url } from '../../../lib/url';

export async function getStaticPaths() {
  return (await allUnits()).map((u) => ({ params: { unit: u.id }, props: { unit: u } }));
}
const { unit } = Astro.props;
const data = await reportData(unit);
---

<Base title={`탐험 리포트 — ${unit.data.title}`}>
  <a slot="head" class="btn ghost small" href={url(`/u/${unit.id}/`)}>🗺️ 탐험 지도</a>
  <div class="report">
    <p class="muted">{unit.data.subject} {unit.data.grade}-{unit.data.semester} · {unit.data.unitNo}단원</p>
    <h1>📋 나의 탐험 리포트 — {unit.data.title}</h1>
    <div id="report"><p class="muted">불러오는 중…</p></div>
  </div>
  <script type="application/json" id="report-data" set:html={JSON.stringify(data)} />
</Base>

<script>
  import { renderReport } from '../../../lib/client/report';
  renderReport();
</script>
