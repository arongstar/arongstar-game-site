---
import Base from '../../layouts/Base.astro';
import { allGames, unitOf } from '../../lib/content';
import { quizshowData, zoomoutData, bingoData } from '../../lib/gamedata';
import '../../styles/board.css';

export async function getStaticPaths() {
  const games = (await allGames()).filter((g) => g.data.mode === 'board');
  return games.map((g) => ({ params: { game: g.id }, props: { game: g } }));
}
const { game } = Astro.props;
const unit = await unitOf(game);
const tpl = game.data.template;
const data = tpl === 'zoomout' ? zoomoutData(game, unit) : tpl === 'bingo' ? bingoData(game, unit) : quizshowData(game, unit);
---

<Base title={game.data.title} bare bodyClass="board-body" wide>
  <div id="board"></div>
  <script type="application/json" id="game-data" set:html={JSON.stringify(data)} data-template={tpl} />
</Base>

<script>
  import { startBoard } from '../../lib/client/board';
  import { startZoomout } from '../../lib/client/zoomout';
  import { startBingoBoard } from '../../lib/client/bingo';
  const tpl = document.getElementById('game-data')!.dataset.template;
  if (tpl === 'zoomout') startZoomout();
  else if (tpl === 'bingo') startBingoBoard();
  else startBoard();
</script>
