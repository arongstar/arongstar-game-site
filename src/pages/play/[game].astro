---
import Base from '../../layouts/Base.astro';
import { allGames, unitOf } from '../../lib/content';
import { missionData, adventureData, jumpData, bridgeData, wordsData, regionData } from '../../lib/gamedata';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const SOLO = ['mission', 'adventure', 'jump', 'bridge', 'words', 'region'];
  const all = await allGames();
  const games = all.filter((g) => SOLO.includes(g.data.template));
  const linked = Object.fromEntries(all.map((g) => [g.id, { title: g.data.title, emoji: g.data.emoji }]));
  const regions = await Promise.all(all.filter((g) => g.data.template === 'region').map(async (g) => ({ game: g, unit: await unitOf(g) })));
  return games.map((g) => ({ params: { game: g.id }, props: { game: g, linked, regions } }));
}
const { game, linked, regions } = Astro.props;
const unit = await unitOf(game);
const t = game.data.template;
const data =
  t === 'region' ? regionData(game, unit, regions, linked)
  : t === 'adventure' ? adventureData(game, unit, linked)
  : t === 'jump' ? jumpData(game, unit)
  : t === 'bridge' ? bridgeData(game, unit)
  : t === 'words' ? wordsData(game, unit)
  : missionData(game, unit);
---

<Base title={game.data.title} wide>
  <a slot="head" class="btn ghost small" href={url(`/u/${unit.id}/`)}>🗺️ {unit.data.title}</a>
  <div id="app" data-template={t}>
    <noscript>이 게임은 자바스크립트가 켜져 있어야 해요.</noscript>
  </div>
  <script type="application/json" id="game-data" set:html={JSON.stringify(data)} />
</Base>

<script>
  import { startMission } from '../../lib/client/mission';
  import { startAdventure } from '../../lib/client/adventure';
  import { startJump } from '../../lib/client/jump';
  import { startBridge } from '../../lib/client/bridge';
  import { startWords } from '../../lib/client/words';
  import { startRegion } from '../../lib/client/rpg';
  const t = document.getElementById('app')?.dataset.template;
  if (t === 'region') startRegion();
  else if (t === 'adventure') startAdventure();
  else if (t === 'jump') startJump();
  else if (t === 'bridge') startBridge();
  else if (t === 'words') startWords();
  else startMission();
</script>
