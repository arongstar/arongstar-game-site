---
import Base from '../layouts/Base.astro';
import { SITE } from '../site.config';
import { allUnits, gamesOf } from '../lib/content';
import { url } from '../lib/url';

const units = await allUnits();
const SUBJECTS = ['국어', '수학', '사회', '과학', '영어', '도덕', '실과', '체육', '음악', '미술'];
const bySubject = new Map<string, typeof units>();
for (const u of units) {
  if (!bySubject.has(u.data.subject)) bySubject.set(u.data.subject, []);
  bySubject.get(u.data.subject)!.push(u);
}
const counts = Object.fromEntries(await Promise.all(units.map(async (u) => [u.id, (await gamesOf(u.id)).length])));
const soon = SUBJECTS.filter((s) => !bySubject.has(s) && s !== '수학');
---

<Base>
  <section class="hero">
    <div style="font-size:3rem" aria-hidden="true">🎲🗺️🏆</div>
    <h1>{SITE.title}</h1>
    <p>과목 → 학년·학기 → 단원 → 차시로 찾아 들어가는 초등 수업 게임 모음이에요. 학생은 태블릿으로, 선생님은 전자칠판으로 함께 해요.</p>
  </section>

  <section class="subject-block">
    <h2>📘 수학</h2>
    <a class="rpg-banner math-banner" href={url('/math-dungeon/')}>
      <span class="rb-emoji" aria-hidden="true">🏰</span>
      <span><b>수학 던전 런 — 6학년 1학기 분수의 나눗셈</b><small>오늘 배운 차시(1~5차시)를 고르면 던전이 열려요. 수 카드로 식을 만들고, 개념 조커를 모으고, 보스의 틀린 풀이를 찾아요. [6수01-10] [6수01-11]</small></span>
      <span class="btn primary small">▶ 던전 입장</span>
    </a>
  </section>

  {
    [...bySubject.entries()].map(([subject, list]) => (
      <section class="subject-block">
        <h2>📘 {subject}</h2>
        {subject === '영어' && (
          <a class="rpg-banner" href={url('/rpg/')}>
            <span class="rb-emoji" aria-hidden="true">🏝️</span>
            <span><b>영어 RPG — Lingo Island 대모험</b><small>내 캐릭터로 섬을 여행하며 Lesson 1~12 를 공부해요. 퀘스트 · 낱말 요정 · 지역 대장 도전!</small></span>
            <span class="btn primary small">▶ 모험 시작</span>
          </a>
        )}
        <div class="unit-grid">
          {list.map((u) => (
            <a class="unit-card" href={url(`/u/${u.id}/`)}>
              <div class="uc-top">
                <div class="uc-grade">
                  {u.data.grade}학년 {u.data.semester}학기 · {u.data.unitNo}단원
                </div>
                <div class="uc-title">
                  <span aria-hidden="true">{u.data.emoji}</span>
                  {u.data.title}
                </div>
              </div>
              <div class="uc-body">
                게임 {counts[u.id]}개 · 성취기준 {u.data.standards.map((s) => `[${s.code}]`).join(' ')}
              </div>
            </a>
          ))}
        </div>
      </section>
    ))
  }

  <section class="subject-block">
    <h2>🛠️ 만들고 있어요</h2>
    <div class="subject-soon">{soon.map((s) => <span>{s}</span>)}</div>
  </section>
</Base>
