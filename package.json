{
  "name": "arongstar-game-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/check-content.mjs && node scripts/audio-manifest.mjs && npm run test:math && astro build && node scripts/copy-apps.mjs",
    "preview": "astro preview",
    "check": "node scripts/check-content.mjs",
    "audio": "node scripts/audio-manifest.mjs && ~/tts/.venv/bin/python scripts/make-audio.py",
    "test:math": "cd math-dungeon && node --test tests/*.test.js"
  },
  "dependencies": {
    "astro": "^7.4.12",
    "d3-geo": "^3.1.2",
    "qrcode": "^1.5.4",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "yaml": "^2.9.1"
  }
}
